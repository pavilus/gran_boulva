# Admin dashboard environment variables
# Copy to .env.local and fill in real values

# Supabase — get from: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key-from-supabase-dashboard>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key-from-supabase-dashboard>

# SMTP — IONOS email account for support@granboulva.com
# Get from: IONOS Control Panel → Email → SMTP settings
SMTP_HOST=smtp.ionos.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@granboulva.com
SMTP_PASS=<ionos-smtp-password>
IONOS_SMTP_PASS=<ionos-smtp-password>
EMAIL_FROM=Gran Boulva <support@granboulva.com>
EMAIL_REPLY_TO=support@granboulva.com

# Stripe — optional (can also be set via Admin → Settings UI, stored in app_settings table)
# Get from: Stripe Dashboard → Developers → API Keys + Webhooks
# STRIPE_SECRET_KEY=sk_live_<your-stripe-secret-key>
# STRIPE_WEBHOOK_SECRET=whsec_<your-webhook-signing-secret>
