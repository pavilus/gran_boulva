# Flutter app environment variables
# Copy to .env and fill in real values
# Get values from: Supabase Dashboard → Settings → API

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key-from-supabase-dashboard>

# Stripe publishable key (safe to expose in client)
# Get from: Stripe Dashboard → Developers → API Keys
STRIPE_PUBLISHABLE_KEY=pk_live_<your-stripe-publishable-key>

# Agora App ID — passed via --dart-define at build time, NOT this file
# --dart-define=AGORA_APP_ID=<your-agora-app-id>
# Get from: Agora Console → Project Management
